{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "functions": {
    "app/main.py": {
      "maxDuration": 180,
      "excludeFiles": "{frontend/**,functions/**,tests/**,docs/**,scripts/**,migrations/**,node_modules/**,.venv/**,venv/**,.git/**,.github/**,.wrangler/**,.vercel-check/**,data/**,exports/**,**/__pycache__/**,**/*.pyc,.env*,.dev.vars*}"
    }
  }
}
