{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "somasai",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-20",
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "routes": [{ "pattern": "smart.somas.ai", "custom_domain": true }],
  "assets": {
    "directory": "./frontend",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"],
    "not_found_handling": "none"
  }
}
