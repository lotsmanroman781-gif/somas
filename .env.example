# Backend only. Set these in your shell or Vercel environment; .env is not auto-loaded.
# This local-only password matches compose.yaml and must never be used in production.
DATABASE_URL=postgresql+psycopg://somas:local-development-only@127.0.0.1:5432/somas
SOMAS_SECURE_COOKIES=0
SOMAS_ALLOW_PUBLIC_SIGNUP=true
SOMAS_ALLOWED_ORIGINS=http://localhost:8788,http://127.0.0.1:8788,http://localhost:8000,http://127.0.0.1:8000
# Match .dev.vars locally and the Cloudflare Pages secret in production.
SOMAS_PROXY_SECRET=local-only-replace-with-a-random-32-character-secret
# Leave empty for free/demo mode. AI mode explicitly requires this PAID API.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Vercel sets VERCEL=1 automatically: uses NullPool and requires a Neon pooled TLS URL.
# Never set DATABASE_URL in Cloudflare Pages.
